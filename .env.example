# ==============================================================================
# Backend Configuration (Go with Gin Engine)
# ==============================================================================
PORT=8080

# --- MongoDB Configuration ---
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017

# For MongoDB Atlas (replace <username>, <password>, <cluster>, and optional <database>):
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/live_polling_db?retryWrites=true&w=majority
# Note: If your password has special characters (@, :, #, %, ?), URL-encode them (e.g. '@' -> '%40')
# Note: Ensure 0.0.0.0/0 is allowed in MongoDB Atlas Network Access for cloud deployments.

# MongoDB Database Name (defaults to database name in URI or 'live_polling_db')
MONGO_DB_NAME=live_polling_db

# --- Redis Configuration ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=

# --- JWT Authentication ---
JWT_SECRET=super-secret-jwt-key-2026

# ==============================================================================
# Frontend Configuration (React 19 + Vite + Tailwind CSS)
# ==============================================================================
# Leave blank when using the Vite reverse proxy (/api -> backend)
VITE_API_BASE_URL=

